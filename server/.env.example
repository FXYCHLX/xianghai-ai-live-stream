# ── AI 服务配置 ──
# 复制本文件为 .env 后填写。.env 不要提交到公开仓库。

# ══════════════════════════════════════════
#  文本模型（导购对话 / 个性化推荐 / 评价总结 / 商品对比）
# ══════════════════════════════════════════

# DeepSeek（推荐，便宜）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 智谱 GLM
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash

# 阿里通义千问
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# 硅基流动（聚合平台，有免费额度）
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 在这里填你的文本模型 Key（必填）
AI_API_KEY=

# ══════════════════════════════════════════
#  视觉模型（「以图搜物」用）
# ══════════════════════════════════════════
# 留空则「以图搜物」提示未配置，其余三个 AI 功能不受影响。
#
# 【重要】BASE_URL 和 KEY 默认继承上面的文本配置，
# 所以用同一家服务商时，只需填 AI_VISION_MODEL 一行。

# 用法一：跟文本模型同一家（最省事，推荐）
# DeepSeek 已支持图片输入，实测 2026-09-17：
#   AI_VISION_MODEL=deepseek-chat                   0.9–1.5s，快
#   AI_VISION_MODEL=deepseek-v4-flash-vision-exp    2.2–3.6s，推理模型，更慢但更细
AI_VISION_MODEL=

# 用法二：视觉另配一家（需要三个都填满，会覆盖上面的继承值）
# 硅基流动（注册送额度）
# AI_VISION_BASE_URL=https://api.siliconflow.cn/v1
# AI_VISION_API_KEY=sk-你的硅基流动key
# AI_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
#
# 智谱 GLM
# AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_VISION_API_KEY=你的智谱key
# AI_VISION_MODEL=glm-4v-plus
#
# 阿里通义
# AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_VISION_API_KEY=sk-你的通义key
# AI_VISION_MODEL=qwen-vl-plus

AI_VISION_BASE_URL=
AI_VISION_API_KEY=

# 服务端口
PORT=3001
